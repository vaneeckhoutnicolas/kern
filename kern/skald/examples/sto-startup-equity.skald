// sto-startup-equity.skald
//
// Security Token Offering for a startup's equity tokenization, encoding
// EU securities-regime compliance
// invariants directly in the contract.
//
// Persona target: Belgian/EU scale-up tokenizing equity (€5M-50M raise).
//
// Securities-regime articles encoded as invariants:
//   Art. 14  — White paper requirements (registered before any offer)
//   Art. 50  — Custody segregation (issuer cannot touch invested funds)
//   Art. 88  — Market abuse prevention (no transfers during blackout windows)
//
// Additional encoded guarantees:
//   - AML/KYC screening required before any token allocation (FATF Travel Rule)
//   - Investor whitelist (Prospectus Regulation Art. 2(e) — qualified investor verification)
//   - Lock-up period enforced (typical for early-stage equity)
//
// The Belgian FSMA regulator (or any auditor) can READ THESE INVARIANTS
// directly. Continuous compliance verification replaces annual audits.
//
// Companion attestations (created off-contract via OpKind.ATTEST):
//   - schema_id "kyc.aml-screening", subject = investor address
//   - schema_id "kyc.accredited-investor", subject = investor address
//   - schema_id "compliance.whitepaper-registered", subject = contract address
//   - schema_id "compliance.blackout-active", subject = contract address
//
// The contract itself does NOT call the attestation registry directly
// (Skald has no cross-contract reads in v1.1). Instead, an off-chain
// compliance oracle reads attestations and calls the contract's entry
// points (set_whitepaper_registered, etc.) to update state.

contract StoStartupEquity {

    storage {
        // --- Issuer identity ---
        issuer:                         address,    // the tokenizing company's address
        regulator:                      address,    // FSMA address — can freeze the contract
        compliance_oracle:              address,    // the address allowed to update compliance state

        // --- Supply & raise ---
        total_supply_target:            int,        // total tokens to be issued
        total_supply_issued:            int,        // tokens issued to date
        funds_raised_mukrn:             int,        // KRN raised to date
        funds_target_mukrn:             int,        // target raise (in mukrn)

        // --- Prospectus Regulation Art. 3: white paper registration ---
        // The whitepaper must be registered with the regulator BEFORE
        // any token can be allocated.
        whitepaper_registered:          bool,
        whitepaper_registered_at_level: int,
        whitepaper_hash:                string,     // hash of the registered document

        // --- MiFID II Art. 16(9): custody segregation ---
        // Issuer cannot withdraw invested funds. Funds flow only to
        // a segregated escrow address managed by an independent custodian.
        // Withdrawals to issuer are blocked until tokens are issued AND
        // a regulatory release event is recorded.
        custodian:                      address,
        funds_released_to_issuer:       int,        // mukrn released so far
        regulatory_release_authorized:  bool,

        // --- MAR Art. 14: market abuse / blackout windows ---
        // During declared blackout windows (e.g., before earnings, during
        // material events), no transfers are permitted. Set by the
        // compliance oracle reading off-chain announcements.
        blackout_active:                bool,
        blackout_started_at_level:      int,

        // --- Lock-up ---
        // No transfers allowed until this level is reached. Standard for
        // early-stage equity (e.g., 12 months from token issuance).
        lockup_until_level:             int,

        // --- Investor whitelist state (per-investor tracking is via
        //     external attestation registry; the contract holds an
        //     aggregate count for quick verification) ---
        whitelisted_investors_count:    int,

        // --- Freeze state (regulator emergency stop) ---
        frozen:                         bool,
    }

    // ========================================================================
    // INVARIANTS — These are the COMPLIANCE PROOFS the regulator reads.
    // ========================================================================

    // Prospectus Regulation Art. 3: No issuance is possible before whitepaper registration.
    invariant prospectus_whitepaper_before_issuance {
        total_supply_issued == 0 || whitepaper_registered
    }

    // MiFID II Art. 16(9): Funds released to issuer can never exceed funds raised
    // AND require regulatory authorization.
    invariant mifid_art16_custody_segregation {
        funds_released_to_issuer <= funds_raised_mukrn
    }

    invariant mifid_art16_release_requires_authorization {
        funds_released_to_issuer == 0 || regulatory_release_authorized
    }

    // No oversubscription
    invariant supply_bounded {
        total_supply_issued <= total_supply_target
    }

    // No negative balances or supply
    invariant nonneg_supply {
        total_supply_issued >= 0
    }

    invariant nonneg_funds {
        funds_raised_mukrn >= 0
    }

    invariant nonneg_released {
        funds_released_to_issuer >= 0
    }

    // ========================================================================
    // SETUP entries — called once at origination or by regulator
    // ========================================================================

    // The compliance oracle confirms the whitepaper has been registered.
    // Off-chain: the oracle has read an attestation from the regulator
    // (schema_id "compliance.whitepaper-registered") and verified its bond
    // is sufficient. Then it calls this entry.
    entry register_whitepaper(hash: string, registered_level: int) {
        require sender == compliance_oracle with "only compliance oracle can register whitepaper";
        require !whitepaper_registered with "whitepaper already registered";
        whitepaper_registered = true;
        whitepaper_registered_at_level = registered_level;
        whitepaper_hash = hash;
    }

    // Regulator authorizes release of funds to issuer (typically after
    // milestone delivery proof or end of investment period).
    entry authorize_regulatory_release() {
        require sender == regulator with "only regulator can authorize release";
        require whitepaper_registered with "whitepaper must be registered first";
        regulatory_release_authorized = true;
    }

    // Regulator can freeze the contract at any time (emergency).
    entry regulator_freeze() {
        require sender == regulator with "only regulator can freeze";
        frozen = true;
    }

    entry regulator_unfreeze() {
        require sender == regulator with "only regulator can unfreeze";
        frozen = false;
    }

    // ========================================================================
    // BLACKOUT entries — MAR Art. 14 (market abuse prevention)
    // ========================================================================

    // Compliance oracle activates blackout window (e.g., earnings announcement
    // pending). All transfers are blocked.
    entry start_blackout(started_at_level: int) {
        require sender == compliance_oracle with "only oracle can start blackout";
        blackout_active = true;
        blackout_started_at_level = started_at_level;
    }

    entry end_blackout() {
        require sender == compliance_oracle with "only oracle can end blackout";
        blackout_active = false;
    }

    // ========================================================================
    // WHITELIST entries — Prospectus Regulation Art. 2(e) (qualified investor verification)
    // ========================================================================

    // The compliance oracle increments the count after verifying an investor's
    // KYC and accredited-investor attestations from the attestation registry.
    entry add_whitelisted_investor() {
        require sender == compliance_oracle with "only oracle can whitelist";
        require whitepaper_registered with "whitepaper not yet registered";
        whitelisted_investors_count = whitelisted_investors_count + 1;
    }

    // ========================================================================
    // ISSUANCE entry — the actual primary token sale
    // ========================================================================

    // Investor sends KRN, receives tokens at the pre-declared rate.
    // The off-chain check that the investor IS on the whitelist happens
    // via the compliance oracle pre-authorizing the call (the oracle
    // submits the tx on behalf of, or after verifying, the investor).
    entry buy_tokens(token_amount: int) {
        require !frozen with "contract frozen by regulator";
        require whitepaper_registered with "whitepaper not registered (Prospectus Regulation Art. 3)";
        require token_amount > 0 with "must buy positive amount";
        require total_supply_issued + token_amount <= total_supply_target with "exceeds total supply";
        require amount > 0 with "must send KRN payment";

        // Track funds and issued tokens.
        funds_raised_mukrn = funds_raised_mukrn + amount;
        total_supply_issued = total_supply_issued + token_amount;

        // The actual token credit to the investor is emitted as a side
        // effect by the runtime (real implementation would maintain a
        // balances mapping; out of v1.1 Skald scope).
    }

    // ========================================================================
    // RELEASE entry — MiFID II Art. 16(9) custody segregation
    // ========================================================================

    // Funds can only be released to the issuer when:
    // 1. The whitepaper is registered
    // 2. The regulator has authorized release
    // 3. The amount requested does not exceed raised funds
    entry release_funds_to_issuer(release_amount: int) {
        require !frozen with "contract frozen";
        require sender == custodian with "only custodian can release funds";
        require regulatory_release_authorized with "regulator has not authorized release";
        require release_amount > 0 with "amount must be positive";
        require funds_released_to_issuer + release_amount <= funds_raised_mukrn
            with "release would exceed raised funds";
        funds_released_to_issuer = funds_released_to_issuer + release_amount;
        // Actual KRN transfer is a runtime side effect.
    }

    // ========================================================================
    // TRANSFER guard — MAR Art. 14 + lock-up
    // ========================================================================

    // Called when a holder wants to transfer their tokens. The contract
    // validates whether the transfer is permitted at this level.
    //
    // This entry records the *attempt*. The actual cross-account transfer
    // ledger lives at the runtime level (not modeled in this v1.1 Skald
    // demonstrator — a v1.2 with mapping types will let the contract
    // hold the balances directly).
    entry attempt_transfer(token_amount: int, current_level: int) {
        require !frozen with "contract frozen";
        require !blackout_active with "transfer blocked: blackout window (MAR Art. 14)";
        require current_level >= lockup_until_level with "tokens still locked";
        require token_amount > 0 with "amount must be positive";
        // The runtime applies the cross-account ledger change.
    }

    // ========================================================================
    // VIEWS — for the regulator and auditors to inspect status
    // ========================================================================

    view is_compliant() -> bool {
        whitepaper_registered && !frozen
    }

    view supply_remaining() -> int {
        total_supply_target - total_supply_issued
    }

    view funds_remaining_in_custody() -> int {
        funds_raised_mukrn - funds_released_to_issuer
    }

    view raise_progress_percent() -> int {
        funds_raised_mukrn * 100 / funds_target_mukrn
    }

    view can_transfer_now(current_level: int) -> bool {
        !frozen && !blackout_active && current_level >= lockup_until_level
    }
}
